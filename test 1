      "source": [
        "# ✅ Install required packages\n",
        "!pip install opencv-python tqdm --quiet\n",
        "\n",
        "# ✅ Imports\n",
        "import os, cv2, zipfile, shutil, warnings\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from tqdm import tqdm\n",
        "from google.colab import files\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, precision_score, recall_score, f1_score,\n",
        "    roc_auc_score, confusion_matrix, roc_curve\n",
        ")\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.utils import class_weight\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras import layers, models\n",
        "from tensorflow.keras.applications import ResNet50V2\n",
        "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# ✅ Suppress specific warnings\n",
        "warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"keras\")\n",
        "warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"IPython\")\n",
        "\n",
        "# ✅ Setup clean upload folder\n",
        "upload_folder = \"/content/uploaded_pngs\"\n",
        "os.makedirs(upload_folder, exist_ok=True)\n",
        "for f in os.listdir(upload_folder):\n",
        "    path = os.path.join(upload_folder, f)\n",
        "    if os.path.isfile(path):\n",
        "        os.remove(path)\n",
        "    elif os.path.isdir(path):\n",
        "        shutil.rmtree(path)\n",
        "\n",
        "# ✅ Upload files (Google Colab only)\n",
        "print(\"Upload .zip or .png files (names must include 'normal' or 'ab_normal'):\")\n",
        "uploaded = files.upload()\n",
        "for fname in uploaded:\n",
        "    if fname.endswith(\".zip\"):\n",
        "        with zipfile.ZipFile(fname, 'r') as zip_ref:\n",
        "            zip_ref.extractall(upload_folder)\n",
        "    elif fname.endswith(\".png\"):\n",
        "        shutil.move(fname, os.path.join(upload_folder, fname))\n",
        "\n",
        "# ✅ Load images and labels\n",
        "def load_images(folder):\n",
        "    X, y = [], []\n",
        "    for file in tqdm(os.listdir(folder), desc=\"Processing images\"):\n",
        "        if file.lower().endswith(\".png\"):\n",
        "            label = 1 if \"abnormal\" in file.lower() or \"ab_normal\" in file.lower() else 0 if \"normal\" in file.lower() else -1\n",
        "            if label == -1:\n",
        "                continue\n",
        "            img = cv2.imread(os.path.join(folder, file), cv2.IMREAD_GRAYSCALE)\n",
        "            if img is not None:\n",
        "                img = cv2.resize(img, (128, 128)) / 255.0\n",
        "                X.append(np.expand_dims(img, axis=-1))\n",
        "                y.append(label)\n",
        "    if len(X) == 0:\n",
        "        raise ValueError(\"No labeled images found.\")\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "# ✅ ResNet50V2 model\n",
        "def build_model(input_shape=(128, 128, 3)):\n",
        "    base = ResNet50V2(include_top=False, input_shape=input_shape, weights='imagenet', pooling='avg')\n",
        "    base.trainable = False\n",
        "    i = layers.Input(shape=input_shape)\n",
        "    x = layers.Conv2D(3, (1, 1))(i)\n",
        "    x = base(x)\n",
        "    x = layers.Dense(64, activation='relu')(x)\n",
        "    o = layers.Dense(1, activation='sigmoid')(x)\n",
        "    return models.Model(inputs=i, outputs=o)\n",
        "\n",
        "# ✅ Grad-CAM Visualization\n",
        "def gradcam(model, img):\n",
        "    img_rgb = np.repeat(img, 3, axis=-1)\n",
        "    grad_model = tf.keras.models.Model([model.inputs], [model.get_layer(index=-4).output, model.output])\n",
        "    with tf.GradientTape() as tape:\n",
        "        inputs = tf.cast(tf.expand_dims(img_rgb, axis=0), tf.float32)\n",
        "        conv_outputs, predictions = grad_model(inputs)\n",
        "        loss = predictions[:, 0]\n",
        "    grads = tape.gradient(loss, conv_outputs)[0]\n",
        "    pooled_grads = tf.reduce_mean(grads, axis=(0, 1))\n",
        "    cam = tf.reduce_sum(tf.multiply(pooled_grads, conv_outputs[0]), axis=-1).numpy()\n",
        "    cam = np.maximum(cam, 0) / (cam.max() + 1e-8)\n",
        "    heatmap = cv2.applyColorMap(np.uint8(255 * cam), cv2.COLORMAP_JET)\n",
        "    overlay = cv2.addWeighted(cv2.cvtColor((img.squeeze()*255).astype(np.uint8), cv2.COLOR_GRAY2BGR), 0.6, heatmap, 0.4, 0)\n",
        "    plt.imshow(overlay); plt.axis('off'); plt.title(\"Grad-CAM\"); plt.tight_layout(); plt.show()\n",
        "\n",
        "# ✅ Enhanced Evaluation\n",
        "def evaluate(model, X_test, y_test):\n",
        "    y_prob = model.predict(X_test).flatten()\n",
        "    y_pred = (y_prob > 0.5).astype(int)\n",
        "    acc = accuracy_score(y_test, y_pred)\n",
        "    prec = precision_score(y_test, y_pred)\n",
        "    rec = recall_score(y_test, y_pred)\n",
        "    f1 = f1_score(y_test, y_pred)\n",
        "    auc = roc_auc_score(y_test, y_prob)\n",
        "    cm = confusion_matrix(y_test, y_pred)\n",
        "    tn, fp, fn, tp = cm.ravel()\n",
        "    spec = tn / (tn + fp)\n",
        "    youden_j = rec + spec - 1\n",
        "\n",
        "    print(f\"\\nAccuracy      : {acc:.2f}\")\n",
        "    print(f\"Precision     : {prec:.2f}\")\n",
        "    print(f\"Recall        : {rec:.2f}\")\n",
        "    print(f\"Specificity   : {spec:.2f}\")\n",
        "    print(f\"F1-Score      : {f1:.2f}\")\n",
        "    print(f\"AUC-ROC       : {auc:.2f}\")\n",
        "    print(f\"Youden's Index: {youden_j:.2f}\")\n",
        "    print(\"\\nConfusion Matrix:\\n\", cm)\n",
        "\n",
        "    plt.figure(figsize=(5, 4))\n",
        "    plt.imshow(cm, interpolation='nearest', cmap=plt.cm.Blues)\n",
        "    plt.title(\"Confusion Matrix\")\n",
        "    plt.colorbar()\n",
        "    classes = ['Normal', 'Abnormal']\n",
        "    tick_marks = np.arange(len(classes))\n",
        "    plt.xticks(tick_marks, classes)\n",
        "    plt.yticks(tick_marks, classes)\n",
        "    thresh = cm.max() / 2.\n",
        "    for i in range(2):\n",
        "        for j in range(2):\n",
        "            plt.text(j, i, f\"{cm[i, j]}\", ha=\"center\", color=\"white\" if cm[i, j] > thresh else \"black\")\n",
        "    plt.xlabel('Predicted')\n",
        "    plt.ylabel('Actual')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    fpr, tpr, _ = roc_curve(y_test, y_prob)\n",
        "    plt.plot(fpr, tpr, label=f\"AUC = {auc:.2f}\")\n",
        "    plt.plot([0, 1], [0, 1], '--', color='gray')\n",
        "    plt.xlabel(\"False Positive Rate\")\n",
        "    plt.ylabel(\"True Positive Rate\")\n",
        "    plt.title(\"ROC Curve\")\n",
        "    plt.legend()\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "# ✅ Save output images with new names\n",
        "def save_classified_images(model, X_test):\n",
        "    os.makedirs(\"classified\", exist_ok=True)\n",
        "    normal_count = abnormal_count = 1\n",
        "    for i, img in enumerate(X_test):\n",
        "        img_rgb = np.repeat(img, 3, axis=-1)\n",
        "        pred = int(model.predict(np.expand_dims(img_rgb, axis=0))[0][0] > 0.5)\n",
        "        label = \"abnormal\" if pred else \"normal\"\n",
        "        count = abnormal_count if pred else normal_count\n",
        "        name = f\"{label}_{count:03}.png\"\n",
        "        cv2.imwrite(f\"classified/{name}\", (img.squeeze()*255).astype(np.uint8))\n",
        "        if pred: abnormal_count += 1\n",
        "        else: normal_count += 1\n",
        "    shutil.make_archive(\"classified_masks\", 'zip', \"classified\")\n",
        "    print(\"Saved: classified_masks.zip\")\n",
        "\n",
        "# ✅ Run pipeline\n",
        "try:\n",
        "    X, y = load_images(upload_folder)\n",
        "    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)\n",
        "    print(f\"Loaded: {len(X)} images | Train: {len(X_train)} | Test: {len(X_test)}\")\n",
        "\n",
        "    cw = class_weight.compute_class_weight('balanced', classes=np.unique(y_train), y=y_train)\n",
        "    class_weights = dict(enumerate(cw))\n",
        "\n",
        "    datagen = ImageDataGenerator(rotation_range=15, width_shift_range=0.1, height_shift_range=0.1, horizontal_flip=True)\n",
        "    train_gen = datagen.flow(np.repeat(X_train, 3, axis=-1), y_train, batch_size=8)\n",
        "\n",
        "    model = build_model()\n",
        "    model.compile(optimizer=tf.keras.optimizers.Adam(1e-4), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "    print(\"Training ResNet50V2 (Transfer Learning)...\")\n",
        "    model.fit(train_gen, epochs=60, validation_data=(np.repeat(X_test, 3, axis=-1), y_test),\n",
        "              class_weight=class_weights, callbacks=[EarlyStopping(patience=5, restore_best_weights=True)])\n",
        "    evaluate(model, np.repeat(X_test, 3, axis=-1), y_test)\n",
        "    gradcam(model, X_test[0])\n",
        "    save_classified_images(model, X_test)\n",
        "except Exception as e:\n",
        "    print(\"ERROR:\", str(e))\n"
      ],
